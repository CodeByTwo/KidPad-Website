# Copy to `.env.local` for local development. Never commit real keys.

# --- Public (inlined at build time; safe to expose) ---
# Cloudflare Turnstile SITE key. The value below is Cloudflare's "always passes"
# test key — swap in your real site key for production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- Secret (server only; set as encrypted vars in Cloudflare Pages) ---
# Turnstile SECRET key. The value below is Cloudflare's test secret that always
# passes — it pairs with the test site key above. Use your real secret in prod.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_your_key_here

# Optional overrides (sensible defaults live in the route handler):
# FEEDBACK_TO_EMAIL=admin@codebytwo.com
# FEEDBACK_FROM_EMAIL=KidPad Feedback <feedback@mail.kidpad.app>
